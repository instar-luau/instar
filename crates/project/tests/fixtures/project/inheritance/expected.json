{
  "/settings/selection/include": [
    "$ROOT/source/**"
  ],
  "/settings/selection/exclude": [],
  "/selection/checking/include": [
    "$ROOT/source/**"
  ],
  "/settings/formatting/width": 100,
  "/settings/formatting/indent_style": "spaces",
  "/settings/formatting/quote_style": "prefer_double",
  "/settings/formatting/requires/order": "grouped",
  "/settings/formatting/requires/groups": [
    "relative",
    "other"
  ],
  "/settings/linting/rules/restricted_globals/settings/parameters/names": {
    "old": "child",
    "kept": "root"
  },
  "/settings/editing/hints/variable_types": true,
