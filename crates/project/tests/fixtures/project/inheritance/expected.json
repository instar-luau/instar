  "/settings/environment/groups/0/namespace": "@child",
  "/settings/environment/groups/0/definitions": [],
  "/settings/environment/groups/0/documentation": [
    "$ROOT/child/child.json"
  ],
  "/settings/environment/roblox": false,
  "/settings/checking": "strict",
  "/settings/environment/globals": [
    "child1",
    "child2"
  ],
  "/settings/resolution/aliases/base": "$ROOT/modules",
  "/settings/linting/rules/LocalUnused/enabled": true
}
