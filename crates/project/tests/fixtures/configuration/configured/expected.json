  "language": {
    "flags": {},
    "declaration_syntax": true
  },
  "resolution": {
    "sourcemaps": [
      "$ROOT/sourcemap.json"
    ],
    "aliases": {},
    "sourcemaps_explicit": true
  },
  "environment": {
    "groups": [
      {
        "namespace": "@custom",
        "definitions": [
          "$ROOT/types.d.luau"
        ],
        "documentation": [
          "$ROOT/docs.json"
        ]
      }
    ],
    "roblox": true,
    "security": "plugin",
    "globals": [],
    "roblox_explicit": true,
    "asset_directory": null,
    "capabilities": null
  },
  "editing": {
    "format_on_save": false,
    "fix_on_save": false,
    "diagnostic_scope": "workspace",
    "completion_snippets": false,
    "imports_enabled": false,
    "import_require": "instance",
    "import_binding": "local",
    "hints": {
      "variable_types": true,
      "parameter_names": true,
      "return_types": true,
      "hide_obvious": false
    }
  },
  "selection": {
    "include": [
      "$ROOT/src/**/*.luau"
    ],
    "exclude": [
      "$ROOT/src/generated/**"
    ],
    "override_exclusions": false,
    "checking": {
      "include": [],
      "exclude": [],
      "override_exclusions": false
    },
    "formatting": {
      "include": [
        "$ROOT/src/**"
      ],
      "exclude": [],
      "override_exclusions": false
    },
    "linting": {
      "include": [
        "$ROOT/src/**"
      ],
      "exclude": [
        "$ROOT/src/vendor/**"
      ],
      "override_exclusions": false
    },
    "index": {
      "include": [
        "$ROOT/src/**"
      ],
      "exclude": [],
      "override_exclusions": false
    },
    "imports": {
      "include": [
        "$ROOT/modules/**"
      ],
      "exclude": [
        "$ROOT/modules/private/**"
      ],
      "override_exclusions": false
    }
  },
  "checking": "nonstrict",
  "type_errors": true
}
