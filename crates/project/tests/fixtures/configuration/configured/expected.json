{
  "formatting": {
    "width": 88,
    "indent_style": "spaces",
    "indent_width": 2,
    "line_ending": "crlf",
    "quote_style": "prefer_single",
    "requires": {
      "order": "grouped",
      "groups": [
        {
          "name": "services",
          "patterns": [
            "@services/**"
          ]
        },
        "alias",
        "relative",
        "other"
      ],
      "blank_lines": "none"
    },
    "final_newline": true
  },
  "linting": {
    "rules": {
      "almost_swapped": {
