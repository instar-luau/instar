      },
      "unused_variable": {
        "enabled": true,
        "severity": "Information",
        "settings": {
          "rule": "unused_variable",
          "parameters": {
            "parameters": true,
            "loop_variables": false,
            "ignore_pattern": "^(_|ignored)"
          }
        }
      },
      "prefer_const": {
        "enabled": true,
        "severity": "Information",
        "settings": {
          "rule": "prefer_const",
          "parameters": {
            "mutated_tables_stay_local": true
          }
        }
      },
      "deprecated": {
        "enabled": true,
        "severity": "Warning",
        "settings": {
          "rule": "deprecated",
          "parameters": {
            "paths": {
              "old.call": "new.call"
            },
            "ambiguous_methods": true
          }
        }
      },
      "restricted_globals": {
        "enabled": true,
        "severity": "Error",
        "settings": {
          "rule": "restricted_globals",
          "parameters": {
            "names": {
              "print": "Use logger"
            }
          }
        }
      },
      "restricted_module_paths": {
        "enabled": true,
        "severity": "Warning",
        "settings": {
          "rule": "restricted_module_paths",
          "parameters": {
            "paths": {
              "legacy/**": "Use new modules"
            }
          }
        }
      },
