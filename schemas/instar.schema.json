{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Instar project configuration. Luau settings live in `[luau]`.",
  "type": "object",
  "properties": {
    "analyze": {
      "description": "Additional file selection for analysis.",
      "$ref": "#/$defs/FileFilter",
      "default": {
        "exclude": [],
        "include": []
      }
    },
    "build": {
      "description": "Additional file selection for builds.",
      "$ref": "#/$defs/FileFilter",
      "default": {
        "exclude": [],
        "include": []
      }
    },
    "exclude": {
      "description": "Global exclude globs; exclusions always win.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "format": {
      "description": "Additional file selection for formatting.",
      "$ref": "#/$defs/FileFilter",
      "default": {
        "exclude": [],
        "include": []
      }
    },
    "graft": {
      "description": "Additional file selection for dependency installation.",
      "$ref": "#/$defs/FileFilter",
      "default": {
        "exclude": [],
        "include": []
      }
    },
    "include": {
      "description": "Global include globs, relative to this manifest; inherited lists append.\nAn empty effective list allows every path.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "lint": {
      "description": "Additional file selection for linting.",
      "$ref": "#/$defs/FileFilter",
      "default": {
        "exclude": [],
        "include": []
      }
    },
    "lsp": {
      "description": "Additional file selection for the language server.",
      "$ref": "#/$defs/FileFilter",
      "default": {
        "exclude": [],
        "include": []
      }
    },
    "luau": {
      "description": "Settings shared by analysis and require resolution.",
      "$ref": "#/$defs/LuauConfig",
      "default": {}
    },
    "roblox": {
      "description": "Optional Roblox sourcemap configuration.",
      "$ref": "#/$defs/RobloxConfig",
      "default": {
        "definitions": null,
        "documentation": null,
        "enabled": null,
        "security": null
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FileFilter": {
      "description": "Service-specific globs, intersected with global selection.\nLists append through inheritance; `[]` adds nothing.",
      "type": "object",
      "properties": {
        "exclude": {
          "description": "Exclude globs relative to their manifest; exclusions always win.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "include": {
          "description": "Include globs relative to their manifest; an empty effective list allows every path.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "LuauConfig": {
      "description": "Luau settings in Instar's `snake_case` configuration format.",
      "type": "object",
      "properties": {
        "aliases": {
          "description": "Case-insensitive aliases; relative targets retain their defining directory.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "globals": {
          "description": "Additional globals. An explicit list replaces the inherited list.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "language_mode": {
          "description": "Typechecking mode.",
          "anyOf": [
            {
              "$ref": "#/$defs/Mode"
            },
            {
              "type": "null"
            }
          ]
        },
        "lint": {
          "description": "Warning overrides, including the `*` wildcard.",
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "lint_errors": {
          "description": "Whether lint warnings are errors.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "type_errors": {
          "description": "Whether type errors are reported.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Mode": {
      "description": "Luau typechecking mode.",
      "oneOf": [
        {
          "description": "Skip typechecking.",
          "type": "string",
          "const": "nocheck"
        },
        {
          "description": "Infer types permissively.",
          "type": "string",
          "const": "nonstrict"
        },
        {
          "description": "Require strict type correctness.",
          "type": "string",
          "const": "strict"
        }
      ]
    },
    "RobloxConfig": {
      "description": "Roblox platform detection, API assets, and sourcemap settings.",
      "type": "object",
      "properties": {
        "definitions": {
          "description": "Ordered declaration paths or HTTPS URLs, appended to inherited files.\nRelative paths use this manifest's directory; `[]` adds nothing.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "documentation": {
          "description": "Ordered documentation paths or HTTPS URLs, appended to inherited files.\nLater files override matching documentation keys; `[]` adds nothing.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "description": "Omission inherits or auto-detects Roblox from the effective sourcemaps.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "security": {
          "description": "API security level; defaults to normal game-script permissions (`none`).",
          "anyOf": [
            {
              "$ref": "#/$defs/Security"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sourcemaps": {
          "description": "Sourcemap files relative to this manifest; their source paths are relative to each map.\nOmission inherits the parent list, or discovers the nearest ancestor `sourcemap.json`.\nAn explicit list replaces it, including `[]` to disable discovery.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Security": {
      "description": "Security level of the published Roblox declarations.",
      "oneOf": [
        {
          "description": "Normal game scripts.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "Local-user privileged APIs.",
          "type": "string",
          "const": "local"
        },
        {
          "description": "Studio plugin APIs.",
          "type": "string",
          "const": "plugin"
        },
        {
          "description": "Roblox-internal APIs.",
          "type": "string",
          "const": "roblox"
        }
      ]
    }
  }
}
